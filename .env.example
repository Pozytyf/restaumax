# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Administration centrale RestauMax — serveur uniquement
# Liste des e-mails Firebase autorisés à accéder à /admin, séparés par des virgules.
# À configurer dans Vercel > Project > Settings > Environment Variables (Production).
# RESTAUMAX_SUPER_ADMIN_EMAILS="admin@votre-domaine.com"

# Firebase Admin SDK — serveur uniquement (ne jamais préfixer ces variables par VITE_)
# Développement local avec un compte de service :
# GOOGLE_APPLICATION_CREDENTIALS="./secrets/firebase-admin.json"
#
# Alternative pour Vercel (variable secrète configurée dans le tableau de bord) :
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'
#
# Développement local isolé : lancer d'abord
# npx --yes firebase-tools@15.34.2 emulators:start --only firestore,auth
# Le serveur Node et le navigateur doivent tous deux viser les émulateurs.
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# VITE_USE_FIREBASE_EMULATOR="true"
# VITE_FIRESTORE_EMULATOR_HOST="127.0.0.1"
# VITE_FIRESTORE_EMULATOR_PORT="8080"
# VITE_FIREBASE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"
# Pour charger le restaurant de démonstration dans l'émulateur :
# npm run seed:local
#
# IMPORTANT : VITE_USE_FIREBASE_EMULATOR doit rester absent ou false sur Vercel/production.


# PayDunya — serveur uniquement (ne jamais préfixer par VITE_ ou NEXT_PUBLIC_)
# Commencer en Preview avec les clés TEST. Ne pas activer le mode live avant validation.
PAYDUNYA_ENABLED="false"
PAYDUNYA_MODE="test"
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_TOKEN=""
# Garde-fous Production : les deux doivent rester false tant que le compte marchand
# et les flux de paiement/remboursement n'ont pas été validés en conditions réelles.
PAYDUNYA_LIVE_ENABLED="false"
PAYDUNYA_PUSH_ENABLED="false"
# PER est distinct de PUSH ; RestauMax utilise PUSH pour les remboursements wallet.
PAYDUNYA_PER_ENABLED="false"
