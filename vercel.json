{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/payments/*.ts": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/core?route=health"
    },
    {
      "source": "/api/inventory",
      "destination": "/api/core?route=inventory"
    },
    {
      "source": "/api/kitchen-item",
      "destination": "/api/core?route=kitchen-item"
    },
    {
      "source": "/api/orders",
      "destination": "/api/core?route=orders"
    },
    {
      "source": "/api/platform-admin",
      "destination": "/api/core?route=platform-admin"
    },
    {
      "source": "/api/pos-orders",
      "destination": "/api/core?route=pos-orders"
    },
    {
      "source": "/api/table-session",
      "destination": "/api/core?route=table-session"
    },
    {
      "source": "/api/tables/qr",
      "destination": "/api/core?route=tables/qr"
    },
    {
      "source": "/api/tables/resolve-qr",
      "destination": "/api/core?route=tables/resolve-qr"
    },
    {
      "source": "/q/:token",
      "destination": "/api/core?route=tables/resolve-qr&token=:token"
    },
    {
      "source": "/r/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/gestion",
      "destination": "/index.html"
    },
    {
      "source": "/gestion/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/staff",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/payments/:path*",
      "destination": "/index.html"
    }
  ]
}
