{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/q/:token",
      "destination": "/api/index?__restaumax_route=tables-resolve-qr&token=:token"
    },
    {
      "source": "/api/health",
      "destination": "/api/index?__restaumax_route=health"
    },
    {
      "source": "/api/inventory",
      "destination": "/api/index?__restaumax_route=inventory"
    },
    {
      "source": "/api/tables",
      "destination": "/api/index?__restaumax_route=tables"
    },
    {
      "source": "/api/customers",
      "destination": "/api/index?__restaumax_route=customers"
    },
    {
      "source": "/api/customer-loyalty",
      "destination": "/api/index?__restaumax_route=customer-loyalty"
    },
    {
      "source": "/api/kitchen-item",
      "destination": "/api/index?__restaumax_route=kitchen-item"
    },
    {
      "source": "/api/order-status",
      "destination": "/api/index?__restaumax_route=order-status"
    },
    {
      "source": "/api/restaurant-images",
      "destination": "/api/index?__restaumax_route=restaurant-images"
    },
    {
      "source": "/api/public-menu",
      "destination": "/api/index?__restaumax_route=public-menu"
    },
    {
      "source": "/api/orders",
      "destination": "/api/index?__restaumax_route=orders"
    },
    {
      "source": "/api/payments",
      "destination": "/api/index?__restaumax_route=payments"
    },
    {
      "source": "/api/platform-admin",
      "destination": "/api/index?__restaumax_route=platform-admin"
    },
    {
      "source": "/api/pos-orders",
      "destination": "/api/index?__restaumax_route=pos-orders"
    },
    {
      "source": "/api/reports",
      "destination": "/api/index?__restaumax_route=reports"
    },
    {
      "source": "/api/restaurant-service",
      "destination": "/api/index?__restaumax_route=restaurant-service"
    },
    {
      "source": "/api/table-session",
      "destination": "/api/index?__restaumax_route=table-session"
    },
    {
      "source": "/api/payments/customer-cash-preference",
      "destination": "/api/index?__restaumax_route=customer-cash-preference"
    },
    {
      "source": "/api/payments/customer-paydunya",
      "destination": "/api/index?__restaumax_route=customer-paydunya"
    },
    {
      "source": "/api/payments/customer-paydunya-reconcile",
      "destination": "/api/index?__restaumax_route=customer-paydunya-reconcile"
    },
    {
      "source": "/api/payments/paydunya-callback",
      "destination": "/api/index?__restaumax_route=paydunya-callback"
    },
    {
      "source": "/api/payments/paydunya-disbursement-callback",
      "destination": "/api/index?__restaumax_route=paydunya-disbursement-callback"
    },
    {
      "source": "/api/subscriptions/billing-cycle",
      "destination": "/api/index?__restaumax_route=subscription-billing-cycle"
    },
    {
      "source": "/api/tables/qr",
      "destination": "/api/index?__restaumax_route=tables-qr"
    },
    {
      "source": "/api/tables/resolve-qr",
      "destination": "/api/index?__restaumax_route=tables-resolve-qr"
    },
    {
      "source": "/r/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/gestion",
      "destination": "/index.html"
    },
    {
      "source": "/gestion/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/staff",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/payments/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/subscriptions/billing-cycle",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://*.paydunya.com https://paydunya.com; script-src 'self' 'unsafe-inline' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://www.google.com/recaptcha/ https://www.recaptcha.net/recaptcha/ https://*.cloudfunctions.net https://*.vercel.app https://*.paydunya.com https://paydunya.com; frame-src 'self' https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/ https://*.firebaseapp.com https://accounts.google.com https://*.paydunya.com https://paydunya.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
