{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    { "source": "/q/:token", "destination": "/api/tables/resolve-qr?token=:token" },
    { "source": "/r/:path*", "destination": "/index.html" },
    { "source": "/gestion", "destination": "/index.html" },
    { "source": "/gestion/:path*", "destination": "/index.html" },
    { "source": "/staff", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
