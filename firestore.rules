rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny: tout chemin non explicitement autorisé est refusé)
    match /{document=**} {
      allow read, write: if false;
    }

    // Subscription and payout metadata is private server-side data. Platform
    // administration accesses it only through Firebase Admin SDK endpoints.
    match /restaurantSubscriptions/{restaurantSlug} {
      allow read, write: if false;
    }

    // Validation primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAccountActive() {
      // A platform admin session is never a restaurant session, even if a
      // legacy managers/{uid} membership remains in Firestore.
      return isSignedIn() &&
        !(request.auth.token.get('role', '') in ['super_admin', 'admin']) && (
        !exists(/databases/$(database)/documents/managers/$(request.auth.uid)) ||
        (
          get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.active == true &&
          request.auth.token.get('sessionVersion', 0) == get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.get('sessionVersion', 0)
        )
      );
    }

    // Restaurant data is public to anonymous QR customers, but authenticated
    // users must belong to the restaurant before reading its profile or menu.
    function isRestaurantActive(targetSlug) {
      return !exists(/databases/$(database)/documents/restaurants/$(targetSlug)) ||
        (
          get(/databases/$(database)/documents/restaurants/$(targetSlug)).data.get('status', 'active') == 'active' &&
          !get(/databases/$(database)/documents/restaurants/$(targetSlug)).data.keys().hasAny(['deletedAt'])
        );
    }


    function isBoundRestaurantOwner(targetSlug) {
      let ownershipPath = /databases/$(database)/documents/restaurants/$(targetSlug)/private/ownership;
      return exists(ownershipPath)
        ? get(ownershipPath).data.get('ownerUid', '') == request.auth.uid
        : get(/databases/$(database)/documents/restaurants/$(targetSlug)).data.get('ownerUid', '') == request.auth.uid;
    }

    function isRestaurantMember(targetSlug) {
      let memberPath = /databases/$(database)/documents/managers/$(request.auth.uid);
      let member = get(memberPath).data;
      return isSignedIn() &&
        exists(memberPath) &&
        isAccountActive() &&
        isRestaurantActive(targetSlug) &&
        member.get('restaurantSlug', '') == targetSlug &&
        member.get('active', false) == true &&
        member.get('role', '') in ['owner', 'manager', 'cashier', 'server', 'kitchen'] &&
        (member.get('role', '') != 'owner' ||
          isBoundRestaurantOwner(targetSlug));
    }

    // Maximum permission ceilings for the six restaurant roles.
    // Explicit grants can only select permissions inside the role's ceiling.
    function roleCanHavePermission(role, permission) {
      return role == 'owner' ||
        (role == 'manager' && permission in [
          'menu.view', 'menu.manage', 'orders.view', 'orders.manage', 'orders.serve',
          'tables.view', 'tables.manage', 'pos.access', 'kitchen.access', 'bar.access',
          'cash.view', 'cash.manage', 'orders.cancel', 'payments.refund', 'reports.view', 'customers.view',
          'customers.manage', 'inventory.view', 'inventory.manage',
          'staff.view', 'staff.manage', 'settings.view'
        ]) ||
        (role == 'cashier' && permission in [
          'orders.view', 'tables.view', 'pos.access', 'cash.view', 'cash.manage',
          'orders.cancel', 'payments.refund', 'reports.cash.view'
        ]) ||
        (role == 'server' && permission in [
          'orders.view', 'tables.view', 'pos.access', 'orders.serve', 'orders.cancel'
        ]) ||
        (role == 'kitchen' && permission in [
          'orders.view', 'kitchen.access', 'bar.access', 'orders.cancel'
        ]);
    }

    // Restaurant access is ALWAYS membership-scoped. Platform custom claims
    // must never grant operational access to every restaurant.
    function hasRestaurantPermission(targetSlug, permission) {
      return isSignedIn() &&
        isAccountActive() &&
        isRestaurantActive(targetSlug) &&
        exists(/databases/$(database)/documents/managers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.restaurantSlug == targetSlug &&
        get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.role in ['owner', 'manager', 'cashier', 'server', 'kitchen'] &&
        (get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.role != 'owner' ||
          isBoundRestaurantOwner(targetSlug)) &&
        (
          get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.role == 'owner' ||
          (
            roleCanHavePermission(
              get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.role,
              permission
            ) &&
            get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.permissions is list &&
            permission in get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.permissions
          )
        );
    }

    function isManagerOfRestaurant(targetSlug) {
      return hasRestaurantPermission(targetSlug, 'settings.manage');
    }

    function isPublicRestaurant(data) {
      return data.keys().hasOnly([
        'slug', 'name', 'isOpen', 'tagline', 'address', 'city', 'phone',
        'currency', 'bannerUrl', 'logoUrl', 'openingHours', 'taxRatePercent',
        'taxMode', 'loyaltyFcfaPerPoint', 'receiptFooter', 'receiptPaperWidth',
        'status', 'createdAt', 'updatedAt', 'country', 'serviceStatusUpdatedAt',
        'tableSessionVersion', 'isOpenBeforeSuspension', 'suspendedAt', 'deletedAt'
      ]);
    }

    function isValidRestaurant(data) {
      return data.keys().hasOnly(['slug', 'name', 'isOpen', 'tagline', 'address', 'city', 'phone', 'currency', 'bannerUrl', 'logoUrl', 'openingHours', 'taxRatePercent', 'taxMode', 'loyaltyFcfaPerPoint', 'receiptFooter', 'receiptPaperWidth', 'status', 'createdAt', 'updatedAt', 'country', 'serviceStatusUpdatedAt', 'tableSessionVersion', 'isOpenBeforeSuspension', 'suspendedAt', 'deletedAt', 'ownerUid', 'ownerName', 'ownerEmail', 'createdBy', 'updatedBy', 'deletedBy', 'suspendedBy', 'subscription'])
        && data.keys().hasAll(['slug', 'name', 'isOpen'])
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.isOpen is bool
        && (!data.keys().hasAny(['taxRatePercent']) || (data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 100))
        && (!data.keys().hasAny(['taxMode']) || data.taxMode in ['exclusive', 'inclusive'])
        && (!data.keys().hasAny(['loyaltyFcfaPerPoint']) || (data.loyaltyFcfaPerPoint is int && data.loyaltyFcfaPerPoint >= 1 && data.loyaltyFcfaPerPoint <= 100000000))
        && (!data.keys().hasAny(['receiptPaperWidth']) || data.receiptPaperWidth in ['58mm', '80mm']);
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['id', 'restaurantSlug', 'name', 'category', 'price', 'available'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.restaurantSlug is string && data.restaurantSlug.size() > 0 && data.restaurantSlug.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.category in ['grillades', 'plats', 'entrees', 'accompagnements', 'boissons', 'desserts']
        && data.price is int && data.price > 0
        && data.available is bool
        && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 2000))
        && (!data.keys().hasAny(['imageUrl']) || (data.imageUrl is string && data.imageUrl.size() <= 2048))
        && (!data.keys().hasAny(['prepTimeMinutes']) || (data.prepTimeMinutes is int && data.prepTimeMinutes >= 1 && data.prepTimeMinutes <= 1440))
        && (!data.keys().hasAny(['trackStock']) || data.trackStock is bool)
        && (data.get('trackStock', false) != true || (data.keys().hasAny(['stockQuantity']) && data.stockQuantity is int && data.stockQuantity >= 0 && data.stockQuantity <= 1000000))
        && (!data.keys().hasAny(['stockQuantity']) || (data.stockQuantity is int && data.stockQuantity >= 0 && data.stockQuantity <= 1000000))
        && (!data.keys().hasAny(['lowStockThreshold']) || (data.lowStockThreshold is int && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 1000000))
        && (!data.keys().hasAny(['allergens']) || (data.allergens is list && data.allergens.size() <= 30))
        && (!data.keys().hasAny(['spiceLevel']) || (data.spiceLevel is int && data.spiceLevel >= 0 && data.spiceLevel <= 3))
        && (!data.keys().hasAny(['pairings']) || (data.pairings is list && data.pairings.size() <= 20))
        && (!data.keys().hasAny(['translations']) || (
          data.translations is map && data.translations.keys().hasOnly(['en', 'pt']) && data.translations.size() <= 2 &&
          (!data.translations.keys().hasAny(['en']) || (
            data.translations.en is map && data.translations.en.keys().hasOnly(['name', 'description']) &&
            (!data.translations.en.keys().hasAny(['name']) || (data.translations.en.name is string && data.translations.en.name.size() <= 200)) &&
            (!data.translations.en.keys().hasAny(['description']) || (data.translations.en.description is string && data.translations.en.description.size() <= 2000))
          )) &&
          (!data.translations.keys().hasAny(['pt']) || (
            data.translations.pt is map && data.translations.pt.keys().hasOnly(['name', 'description']) &&
            (!data.translations.pt.keys().hasAny(['name']) || (data.translations.pt.name is string && data.translations.pt.name.size() <= 200)) &&
            (!data.translations.pt.keys().hasAny(['description']) || (data.translations.pt.description is string && data.translations.pt.description.size() <= 2000))
          ))
        ))
        && (!data.keys().hasAny(['optionGroups']) || (data.optionGroups is list && data.optionGroups.size() <= 20))
        && (!data.keys().hasAny(['availableExtras']) || (data.availableExtras is list && data.availableExtras.size() <= 50))
        && (!data.keys().hasAny(['tags']) || (data.tags is list && data.tags.size() <= 30));
    }

    function isValidTable(data) {
      return data.keys().hasAll(['id', 'tableNumber', 'capacity', 'isActive'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.tableNumber is string && data.tableNumber.size() > 0 && data.tableNumber.size() <= 64
        && data.capacity is number && data.capacity > 0 && data.capacity <= 100
        && data.isActive is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'restaurantSlug', 'orderMode', 'items', 'totalAmount', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 64
        && data.restaurantSlug is string && data.restaurantSlug.size() > 0 && data.restaurantSlug.size() <= 100
        && data.orderMode in ['sur_place', 'a_emporter']
        && (data.orderMode != 'sur_place' || (data.tableNumber is string && data.tableNumber.size() > 0 && data.tableNumber.size() <= 64))
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status in ['pending', 'in_prep', 'ready', 'completed', 'cancelled'];
    }

    // Role verification collection: managers
    // Read: authenticated manager checking only their own entry
    // List: STRICTLY FORBIDDEN (no scraping or enumeration of staff accounts)
    // Write: STRICTLY FORBIDDEN from client SDK (must be provisioned via Admin SDK / Firebase Console)
    match /managers/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    // Restaurant profile and service status
    // Public get by exact identifier (slug) for customers scanning QR code
    // List of all restaurants: FORBIDDEN (not needed by QR menu or single-restaurant hub)
    // Create/update restricted strictly to verified managers of this restaurant
    match /restaurants/{restaurantSlug} {
      allow get: if isValidId(restaurantSlug) &&
        (
          resource == null ||
          (
            resource.data.get('status', 'active') == 'active' &&
            !resource.data.keys().hasAny(['deletedAt']) &&
            isPublicRestaurant(resource.data)
          )
        );
      allow list: if false;
      allow create: if hasRestaurantPermission(restaurantSlug, 'settings.manage') && isValidId(restaurantSlug) && isValidRestaurant(incoming()) && isPublicRestaurant(incoming());
      allow update: if hasRestaurantPermission(restaurantSlug, 'settings.manage') &&
        isValidId(restaurantSlug) && isValidRestaurant(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'tagline', 'address', 'city', 'phone', 'bannerUrl', 'logoUrl',
          'openingHours', 'currency', 'country', 'isOpen', 'taxRatePercent', 'taxMode',
          'loyaltyFcfaPerPoint', 'receiptFooter', 'receiptPaperWidth'
        ]);
      allow delete: if false;

      // Ownership and audit identity metadata is private and server-only.
      match /private/{privateDoc} {
        allow read, write: if false;
      }

      // Menu catalog subcollection
      // Public get and list for QR menu viewing
      // Create/update/delete restricted strictly to verified managers of this restaurant
      match /menuItems/{dishId} {
        // Menu documents contain internal stock metadata. Browser clients may
        // read them only after proving restaurant membership and operational role.
        // Anonymous customers use the sanitized GET /api/public-menu endpoint.
        allow get, list: if isValidId(dishId) && isRestaurantActive(restaurantSlug) &&
          (hasRestaurantPermission(restaurantSlug, 'menu.manage') ||
           hasRestaurantPermission(restaurantSlug, 'pos.access'));
        allow create: if hasRestaurantPermission(restaurantSlug, 'menu.manage') &&
          isValidId(dishId) && isValidMenuItem(incoming()) &&
          incoming().restaurantSlug == restaurantSlug && incoming().id == dishId;
        allow update: if hasRestaurantPermission(restaurantSlug, 'menu.manage') &&
          isValidId(dishId) && isValidMenuItem(incoming()) &&
          incoming().restaurantSlug == restaurantSlug && incoming().id == dishId && existing().get('restaurantSlug', '') == restaurantSlug && existing().get('id', '') == dishId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'category', 'price', 'available', 'description', 'imageUrl',
            'prepTimeMinutes', 'optionGroups', 'availableExtras', 'tags', 'trackStock', 'stockQuantity', 'lowStockThreshold', 'allergens', 'spiceLevel', 'pairings', 'translations'
          ]);
        allow delete: if hasRestaurantPermission(restaurantSlug, 'menu.manage') && isValidId(dishId) && resource.data.get('restaurantSlug', '') == restaurantSlug &&
          !existsAfter(/databases/$(database)/documents/restaurants/$(restaurantSlug)/menuRecipes/$(dishId));
      }

      // Tables contain operational data and must never be publicly readable.
      // Customer QR resolution and session validation use Firebase Admin SDK only.
      // Managers retain scoped access for floor/table administration.
      match /tables/{tableId} {
        allow get, list: if (hasRestaurantPermission(restaurantSlug, 'tables.view') || hasRestaurantPermission(restaurantSlug, 'tables.manage')) &&
          (get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.get('role', '') != 'server' || resource.data.get('assignedWaiter', '') == request.auth.uid);
        // Table creation and number reservation are atomic in the trusted API.
        allow create: if false;
        allow update: if hasRestaurantPermission(restaurantSlug, 'tables.manage') &&
          isValidId(tableId) && isValidTable(incoming()) && incoming().id == tableId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'section', 'capacity', 'isActive', 'status', 'covers',
            'seatedAt', 'assignedWaiter', 'currentOrderId', 'currentTotal'
          ]);
        allow delete: if hasRestaurantPermission(restaurantSlug, 'tables.manage') && isValidId(tableId);
      }

      // Unique table-number reservations are server-only and transactionally managed.
      match /table_number_index/{indexId} {
        allow read, write: if false;
      }

      // QR token fingerprints and table sessions are server-only collections.
      // No client SDK access is granted; the global default-deny rule remains in force.
      match /table_qr_tokens/{tokenHash} {
        allow read, write: if false;
      }
      match /table_sessions/{sessionHash} {
        allow read, write: if false;
      }

      // Customer directory: private to authorized restaurant staff.
      match /customers/{customerId} {
        allow get, list: if hasRestaurantPermission(restaurantSlug, 'customers.view') || hasRestaurantPermission(restaurantSlug, 'customers.manage');
        // Customer creation is server-only so normalized phone uniqueness is transactional.
        allow create: if false;
        allow update: if hasRestaurantPermission(restaurantSlug, 'customers.manage')
          && isValidId(customerId)
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'notes', 'updatedAt', 'archivedAt', 'archivedByUid'])
          && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 160
          && incoming().phone is string && incoming().phone.size() > 0 && incoming().phone.size() <= 40
          && (!incoming().diff(existing()).affectedKeys().hasAny(['archivedAt', 'archivedByUid']) ||
              (incoming().archivedAt is int && incoming().archivedByUid == request.auth.uid));
        allow delete: if false;
      }

      // Inventory catalog and immutable stock movement audit trail.
      match /inventoryItems/{itemId} {
        allow get, list: if (hasRestaurantPermission(restaurantSlug, 'inventory.view') || hasRestaurantPermission(restaurantSlug, 'inventory.manage')) && resource.data.get('restaurantSlug', restaurantSlug) == restaurantSlug;
        // Inventory mutations are Admin SDK only and must pass the transactional API.
        allow create, update, delete: if false;
      }

      match /menuRecipes/{menuItemId} {
        allow get, list: if hasRestaurantPermission(restaurantSlug, 'inventory.view') || hasRestaurantPermission(restaurantSlug, 'inventory.manage');
        // Recipe creation and edits remain backend-only. A linked recipe may be
        // deleted by a catalogue manager only in the same transaction that deletes
        // its menu item, preventing orphaned recipe records.
        allow create, update: if false;
        allow delete: if hasRestaurantPermission(restaurantSlug, 'menu.manage') && isValidId(menuItemId) &&
          !existsAfter(/databases/$(database)/documents/restaurants/$(restaurantSlug)/menuItems/$(menuItemId));
      }

      match /menuCustomizationRecipes/{recipeId} {
        allow get, list: if hasRestaurantPermission(restaurantSlug, 'inventory.view') || hasRestaurantPermission(restaurantSlug, 'inventory.manage');
        // Customization recipes are written only through the trusted inventory API.
        allow create, update: if false;
        allow delete: if hasRestaurantPermission(restaurantSlug, 'menu.manage') && isValidId(recipeId) &&
          !existsAfter(/databases/$(database)/documents/restaurants/$(restaurantSlug)/menuItems/$(resource.data.menuItemId));
      }

      match /stockMovements/{movementId} {
        allow get, list: if hasRestaurantPermission(restaurantSlug, 'inventory.view') || hasRestaurantPermission(restaurantSlug, 'inventory.manage');
        // Append-only from the trusted Admin SDK transaction; no client writes.
        allow create, update, delete: if false;
      }

      // Menu stock movements are an immutable audit trail for sellable portions.
      match /menuStockMovements/{movementId} {
        allow get, list: if (hasRestaurantPermission(restaurantSlug, 'inventory.view') || hasRestaurantPermission(restaurantSlug, 'inventory.manage')) &&
          resource.data.get('restaurantSlug', '') == restaurantSlug;
        allow create, update, delete: if false;
      }

      // Orders subcollection
      // Create: STRICTLY FORBIDDEN from client SDK (must go through trusted server backend /api/orders)
      // Direct reads are denied: customer confirmation is returned by POST /api/orders.
      // List: restricted strictly to authorized restaurant personnel.
      // Update: forbidden from the client SDK; the trusted server performs atomic lifecycle and stock writes
      // Delete: STRICTLY FORBIDDEN (audit trail preserved)
      // Payment records are server-managed only. Client SDK writes cannot
      // create, collect, alter, or refund a payment.
      match /payments/{paymentId} {
        allow read, write: if false;
      }

      match /orders/{orderId} {
        allow create: if false;
        allow get: if false;
        allow list: if (hasRestaurantPermission(restaurantSlug, 'orders.view') || hasRestaurantPermission(restaurantSlug, 'orders.manage') || hasRestaurantPermission(restaurantSlug, 'kitchen.access') || hasRestaurantPermission(restaurantSlug, 'reports.view')) &&
          (get(/databases/$(database)/documents/managers/$(request.auth.uid)).data.get('role', '') != 'server' || resource.data.get('assignedWaiterUid', '') == request.auth.uid);
        // All order status transitions and KDS progress are server-managed so stock
        // consumption/restoration and the order state commit in one Admin SDK transaction.
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
