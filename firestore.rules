rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny: tout chemin non explicitement autorisé est refusé)
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Manager role verification scoped to a specific restaurant:
    // Requires authentication AND either:
    // 1. Custom Claims role == 'admin' (global manager)
    // 2. Custom Claims role == 'manager' and restaurantSlug == targetSlug
    // 3. Presence of a trusted document in /managers/{uid} with role == 'admin' or role == 'manager' matching targetSlug
    function isManagerOfRestaurant(targetSlug) {
      let managerExists = isSignedIn() &&
        exists(/databases/$(database)/documents/managers/$(request.auth.uid));
      let managerData = managerExists
        ? get(/databases/$(database)/documents/managers/$(request.auth.uid)).data
        : {'role': '', 'restaurantSlug': '', 'restaurants': []};
      let tokenRole = isSignedIn() ? request.auth.token.get('role', '') : '';
      let tokenRestaurant = isSignedIn() ? request.auth.token.get('restaurantSlug', '') : '';
      let tokenRestaurants = isSignedIn() ? request.auth.token.get('restaurants', []) : [];
      return isSignedIn() && (
        tokenRole == 'admin' ||
        (tokenRole == 'manager' && (
          tokenRestaurant == targetSlug ||
          targetSlug in tokenRestaurants
        )) ||
        (
          managerExists &&
          (
            managerData.get('role', '') == 'admin' ||
            (
              managerData.get('role', '') == 'manager' &&
              (
                managerData.get('restaurantSlug', '') == targetSlug ||
                targetSlug in managerData.get('restaurants', [])
              )
            )
          )
        )
      );
    }

    function isValidRestaurant(data) {
      return data.keys().hasAll(['slug', 'name', 'isOpen'])
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.isOpen is bool;
    }

    function isValidMenuItem(data) {
      return data.keys().hasAll(['id', 'restaurantSlug', 'name', 'category', 'price', 'available'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.restaurantSlug is string && data.restaurantSlug.size() > 0 && data.restaurantSlug.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.price is number && data.price >= 0
        && data.available is bool;
    }

    function isValidTable(data) {
      return data.keys().hasAll(['id', 'tableNumber', 'capacity', 'isActive'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 64
        && data.tableNumber is string && data.tableNumber.size() > 0 && data.tableNumber.size() <= 64
        && data.capacity is number && data.capacity > 0 && data.capacity <= 100
        && data.isActive is bool;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'orderNumber', 'restaurantSlug', 'orderMode', 'items', 'totalAmount', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() <= 64
        && data.restaurantSlug is string && data.restaurantSlug.size() > 0 && data.restaurantSlug.size() <= 100
        && data.orderMode in ['sur_place', 'a_emporter']
        && (data.orderMode != 'sur_place' || (data.tableNumber is string && data.tableNumber.size() > 0 && data.tableNumber.size() <= 64))
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.totalAmount is number && data.totalAmount >= 0
        && data.status in ['pending', 'in_prep', 'ready', 'completed', 'cancelled'];
    }

    // Role verification collection: managers
    // Read: authenticated manager checking only their own entry
    // List: STRICTLY FORBIDDEN (no scraping or enumeration of staff accounts)
    // Write: STRICTLY FORBIDDEN from client SDK (must be provisioned via Admin SDK / Firebase Console)
    match /managers/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }

    // Restaurant profile and service status
    // Public get by exact identifier (slug) for customers scanning QR code
    // List of all restaurants: FORBIDDEN (not needed by QR menu or single-restaurant hub)
    // Create/update restricted strictly to verified managers of this restaurant
    // Un gestionnaire peut lire uniquement son propre document d'habilitation.
    // Les créations et modifications restent exclusivement réservées à l'Admin SDK.
    match /managers/{managerId} {
      allow get: if isSignedIn() && request.auth.uid == managerId;
      allow list, create, update, delete: if false;
    }

    match /restaurants/{restaurantSlug} {
      allow get: if isValidId(restaurantSlug);
      allow list: if false;
      allow create: if isManagerOfRestaurant(restaurantSlug) && isValidId(restaurantSlug)
        && isValidRestaurant(incoming()) && incoming().slug == restaurantSlug;
      allow update: if isManagerOfRestaurant(restaurantSlug) && isValidId(restaurantSlug)
        && isValidRestaurant(incoming()) && incoming().slug == restaurantSlug;
      allow delete: if false;

      // Menu catalog subcollection
      // Public get and list for QR menu viewing
      // Create/update/delete restricted strictly to verified managers of this restaurant
      match /menuItems/{dishId} {
        allow get: if isValidId(dishId);
        allow list: if true;
        allow create: if isManagerOfRestaurant(restaurantSlug) && isValidId(dishId)
          && isValidMenuItem(incoming()) && incoming().id == dishId && incoming().restaurantSlug == restaurantSlug;
        allow update: if isManagerOfRestaurant(restaurantSlug) && isValidId(dishId)
          && isValidMenuItem(incoming()) && incoming().id == dishId && incoming().restaurantSlug == restaurantSlug;
        allow delete: if isManagerOfRestaurant(restaurantSlug) && isValidId(dishId);
      }

      // Tables subcollection: données opérationnelles réservées au personnel autorisé.
      // Le client QR transmet le numéro de table; la validation réelle est faite côté serveur.
      match /tables/{tableId} {
        allow get: if isManagerOfRestaurant(restaurantSlug) && isValidId(tableId);
        allow list: if isManagerOfRestaurant(restaurantSlug);
        allow create, update: if isManagerOfRestaurant(restaurantSlug) && isValidId(tableId)
          && isValidTable(incoming()) && incoming().id == tableId;
        allow delete: if isManagerOfRestaurant(restaurantSlug) && isValidId(tableId);
      }

      // Orders subcollection
      // Create: STRICTLY FORBIDDEN from client SDK (must go through trusted server backend /api/orders)
      // Get/List: réservés aux gestionnaires autorisés de ce restaurant.
      // L'accès public par identifiant seul exposerait les données client d'une commande.
      // Le suivi client devra utiliser un mécanisme dédié avec jeton opaque non devinable.
      // Update: limité aux champs opérationnels par les gestionnaires autorisés.
      // Delete: STRICTLY FORBIDDEN (audit trail preserved)
      match /orders/{orderId} {
        allow create: if false;
        allow get: if isManagerOfRestaurant(restaurantSlug) && isValidId(orderId);
        allow list: if isManagerOfRestaurant(restaurantSlug);
        allow update: if isManagerOfRestaurant(restaurantSlug) 
          && isValidId(orderId) 
          && incoming().id == existing().id
          && incoming().restaurantSlug == existing().restaurantSlug
          && incoming().orderNumber == existing().orderNumber
          && incoming().totalAmount == existing().totalAmount
          && incoming().items == existing().items
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'statusUpdatedAt', 'kitchenNotes'])
          && incoming().status in ['pending', 'in_prep', 'ready', 'completed', 'cancelled'];
        allow delete: if false;
      }
    }
  }
}
